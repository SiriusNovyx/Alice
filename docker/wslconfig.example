# Example WSL 2 resource limits for Docker Desktop builds.
# Copy/merge into: %USERPROFILE%\.wslconfig
# Then run: wsl --shutdown
# (Docker Desktop → Settings says limits are managed by Windows/WSL — this file is how.)
#
# NOTE: C:\Users\<you>\AppData\Local\Docker\wsl is Docker's VHD data directory,
# not the config file. The config is always %USERPROFILE%\.wslconfig

[wsl2]
memory=6GB
processors=4
swap=2GB
